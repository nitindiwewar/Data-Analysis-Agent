# GEMINI_API_KEY: Required for Google Gemini 3.7 Flash AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MySQL Database Configuration (Optional - Built-in relational engine runs out of the box with zero setup)
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_DATABASE="retail_sales_db"
MYSQL_USER=""
MYSQL_PASSWORD=""

# Flowise Workflow Orchestration (Optional - Built-in Agent engine executes the Flowise graph natively)
FLOWISE_URL=""
FLOWISE_API_KEY=""
